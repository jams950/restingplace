# ---- Flask ----------------------------------------------------------
APP_ENV=production                 # development | production
FLASK_SECRET_KEY=change-me-to-a-long-random-string   # python -c "import secrets;print(secrets.token_urlsafe(48))"
PUBLIC_BASE_URL=https://your-domain.example         # used in email links and QR codes
SESSION_COOKIE_SECURE=true         # set false only for http://localhost development
REMEMBER_ME_DAYS=14

# ---- Supabase (Project Settings -> API) --------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# SERVER-SIDE ONLY. Never put this in templates, JavaScript or a public repo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_TIMEOUT=15

# ---- Rate limiting (use Redis when running more than one worker) ------
RATELIMIT_STORAGE_URI=memory://    # e.g. redis://localhost:6379/0

# ---- Background jobs ------------------------------------------------
# true = run jobs inside the web process (use with ONE worker only).
# Otherwise schedule `flask --app wsgi run-jobs` every 15 minutes (cron / platform scheduler).
ENABLE_SCHEDULER=false
JOB_INTERVAL_MINUTES=15

# ---- Email (optional; leave SMTP_HOST empty to skip emails) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
MAIL_FROM=
